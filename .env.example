# Configuración del sistema (Docker Compose lee este archivo automáticamente)
PUERTO_WEB=8080

POSTGRES_DB=escuela
POSTGRES_USER=escuela
POSTGRES_PASSWORD=cambia-esta-contraseña

# Clave para firmar sesiones. NO la compartas.
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria

# Administrador inicial (cámbiala desde "Mi cuenta" después de entrar)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# true = carga alumnos, cursos y pagos de ejemplo la primera vez que arranca.
# Cuando termines de probar: ponlo en false y reinicia con "borrar-datos" (ver README).
CARGAR_DATOS_DEMO=true

# Pon true solo si publicas el sistema detrás de HTTPS
COOKIE_SECURE=false
